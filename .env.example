# 서버 비밀 — 절대 브라우저로 내려보내지 않는다
PORTONE_API_SECRET=
ANTHROPIC_API_KEY=

# 포트원 상점 정보. 둘 다 있어야 결제 버튼이 켜진다
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=

# 서비스 식별
SITE_NAME=
# 포트원에 신청한 주소와 글자 단위로 같아야 한다
SITE_URL=https://

# 사업자 정보 — 사업자등록증·PG 신청서와 글자 단위로 일치시킬 것.
# 하나라도 다르면 심사에서 반려되고, 다시 넣는 데 며칠이 든다.
BIZ_COMPANY=
BIZ_REPRESENTATIVE=
BIZ_REG_NUMBER=
# 통신판매업 신고는 PG 계약보다 늦게 끝나는 게 정상이다. 오픈 전까지만 채우면 된다
BIZ_MAIL_ORDER_NUMBER=
BIZ_ADDRESS=
BIZ_PHONE=
BIZ_EMAIL=
# 비우면 대표자로 자동 지정된다
BIZ_PRIVACY_OFFICER=
BIZ_HOSTING=
