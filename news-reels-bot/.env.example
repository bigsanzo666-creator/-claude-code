# 이 파일을 .env 로 복사해서 실제 값을 채운 뒤,
# Claude Code 환경 설정(환경변수)에 등록하세요. .env 자체는 절대 커밋하지 마세요.

# 네이버 개발자센터(developers.naver.com) - "검색" API 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 텔레그램 봇 (@BotFather 로 봇 생성 후 발급되는 토큰)
TELEGRAM_BOT_TOKEN=
# 알림을 받을 본인 chat id (@userinfobot 등에게 말 걸어서 확인)
TELEGRAM_CHAT_ID=

# Meta 개발자 앱에서 발급한 Instagram 장기 액세스 토큰
# (instagram_basic, instagram_content_publish, pages_read_engagement 권한 필요)
IG_ACCESS_TOKEN=
# 연결된 Instagram 프로페셔널 계정의 ID (Graph API Explorer로 조회)
IG_BUSINESS_ACCOUNT_ID=
